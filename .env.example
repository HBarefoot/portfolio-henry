NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase — used server-side only (anon key, canvas schema)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudflare Turnstile — contact-form CAPTCHA. Site key is public; secret is server-only.
# If unset, the CAPTCHA check is skipped (fine for local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Upstash Redis — per-IP rate limiting for the contact form.
# If unset, rate limiting is disabled (fine for local dev).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
